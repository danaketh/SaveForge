//! A `SaveForge` plugin built on the schema-driven form helper.
//! See `docs/PLUGIN_AUTHORING.md` for the full guide.

// SDK items are written with their full path, so this crate's own type
// names can never clash with them.
use saveforge_sdk::form;

#[derive(Debug)]
pub struct {{type_name}};

pub type {{type_name}}Document = form::FormDocument<form::JsonCodec>;

/// Detection priority. When several plugins claim a file, the highest wins.
pub const PRIORITY: u32 = 1;

impl saveforge_sdk::Plugin for {{type_name}} {
    type Doc = {{type_name}}Document;

    /// Claims any JSON object. Replace this with a check for a key that only
    /// this game's saves contain, and raise `PRIORITY` to match.
    fn detect(_file_name: &str, header: &[u8]) -> Option<u32> {
        let header = header.strip_prefix(b"\xEF\xBB\xBF").unwrap_or(header);
        header
            .iter()
            .find(|b| !b.is_ascii_whitespace())
            .is_some_and(|b| *b == b'{')
            .then_some(PRIORITY)
    }

    fn open(
        _file_name: &str,
        bytes: Vec<u8>,
        _aux: Vec<saveforge_sdk::AuxFile>,
    ) -> Result<{{type_name}}Document, String> {
        {{type_name}}Document::open(schema(), &bytes)
    }
}

/// The editor: pages become tabs, and each field edits the value at its
/// dot-path in the save.
pub fn schema() -> form::FormSchema {
    form::FormSchema::new().page(
        form::FormPage::new("General")
            .section(form::FormSection::new().field(form::text("name", "Name").required())),
    )
}

saveforge_sdk::export_plugin!({{type_name}});
