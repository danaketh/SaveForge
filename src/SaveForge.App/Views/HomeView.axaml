<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:SaveForge.App.ViewModels"
             xmlns:models="clr-namespace:SaveForge.Core.Models;assembly=SaveForge.Core"
             x:Class="SaveForge.App.Views.HomeView"
             x:DataType="vm:HomeViewModel">
  <Grid>

    <!-- Empty state: no plugins installed -->
    <StackPanel IsVisible="{Binding IsEmpty}"
                VerticalAlignment="Center" HorizontalAlignment="Center" Spacing="12">
      <TextBlock Text="No plugins installed."
                 Classes="dim"
                 FontSize="14" HorizontalAlignment="Center"/>
      <Button Content="Browse Store" Command="{Binding BrowseStoreCommand}"
              Classes="primary" HorizontalAlignment="Center"/>
    </StackPanel>

    <!-- No selection (plugins exist but none selectable) -->
    <StackPanel IsVisible="{Binding IsShowingNoSelection}"
                VerticalAlignment="Center" HorizontalAlignment="Center" Spacing="8">
      <TextBlock Text="No plugins could be loaded."
                 Classes="dim" FontSize="14" HorizontalAlignment="Center"/>
      <TextBlock Text="Check the Store or plugin compatibility."
                 Classes="faint" HorizontalAlignment="Center"/>
    </StackPanel>

    <!-- Path not configured -->
    <StackPanel IsVisible="{Binding IsShowingConfigurePrompt}"
                VerticalAlignment="Center" HorizontalAlignment="Center" Spacing="8">
      <TextBlock Text="📁" FontSize="32" HorizontalAlignment="Center"/>
      <TextBlock Text="No save path configured"
                 Classes="heading" FontSize="16" HorizontalAlignment="Center"/>
      <TextBlock Text="Set a path so SaveForge can find your saves."
                 Classes="dim" HorizontalAlignment="Center"/>
      <Button Content="Set Path" Command="{Binding StartEditPathCommand}"
              Classes="primary" HorizontalAlignment="Center" Margin="0,4,0,0"/>
    </StackPanel>

    <!-- Save list (path configured, not editing) -->
    <Grid IsVisible="{Binding IsShowingSaveList}" RowDefinitions="Auto,Auto,Auto,*">

      <!-- Plugin header -->
      <Border Grid.Row="0"
              Padding="12,10,12,10"
              Background="{DynamicResource BrushBg2}"
              BorderBrush="{DynamicResource BrushLine}"
              BorderThickness="0,0,0,1">
        <Grid ColumnDefinitions="Auto,*,Auto">
          <!-- Plugin icon (if available) -->
          <Image Grid.Column="0"
                 Source="{Binding SelectedPluginIcon}"
                 IsVisible="{Binding SelectedPluginHasIcon}"
                 Width="32" Height="32"
                 Stretch="UniformToFill"
                 Margin="0,0,10,0"/>
          <StackPanel Grid.Column="1" Spacing="2" VerticalAlignment="Center">
            <TextBlock Text="{Binding SelectedPlugin.Manifest.Name}"
                       Classes="subheading"/>
            <TextBlock Text="{Binding SaveDirectory}"
                       Classes="faint"
                       TextTrimming="CharacterEllipsis"/>
          </StackPanel>
          <Button Grid.Column="2"
                  Content="✏"
                  Command="{Binding StartEditPathCommand}"
                  Classes="ghost icon-btn"
                  ToolTip.Tip="Edit save path"
                  Width="28" Height="28"/>
        </Grid>
      </Border>

      <!-- Resolved path hint -->
      <Border Grid.Row="1"
              Padding="16,5"
              Background="{DynamicResource BrushBg0}"
              BorderBrush="{DynamicResource BrushLine}"
              BorderThickness="0,0,0,1"
              IsVisible="{Binding ResolvedSaveDirectory, Converter={x:Static StringConverters.IsNotNullOrEmpty}}">
        <TextBlock Text="{Binding ResolvedSaveDirectory, StringFormat='→ {0}'}"
                   Classes="faint"/>
      </Border>

      <!-- Section label -->
      <TextBlock Grid.Row="2"
                 Margin="14,8,14,4"
                 Classes="faint"
                 Text="SAVES"/>

      <!-- Save items -->
      <ScrollViewer Grid.Row="3">
        <StackPanel Margin="8,0,8,8">
          <TextBlock Text="No save files found at this path."
                     Classes="faint"
                     Margin="6,8"
                     IsVisible="{Binding !HasSaves}"/>
          <ItemsControl ItemsSource="{Binding Saves}">
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="models:SaveFileInfo">
                <Button HorizontalAlignment="Stretch"
                        HorizontalContentAlignment="Left"
                        Click="SaveItem_Click"
                        Margin="0,2"
                        Background="{DynamicResource BrushBg2}"
                        BorderBrush="{DynamicResource BrushLine}"
                        BorderThickness="1"
                        CornerRadius="0"
                        Padding="12,8">
                  <StackPanel Spacing="2">
                    <TextBlock Text="{Binding FileName}" FontWeight="SemiBold"/>
                    <TextBlock Classes="faint"
                               Text="{Binding LastModifiedDisplay}"/>
                  </StackPanel>
                </Button>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </StackPanel>
      </ScrollViewer>
    </Grid>

    <!-- Editing path -->
    <Grid IsVisible="{Binding IsShowingEditPath}" RowDefinitions="Auto,Auto,Auto,*">

      <!-- Plugin header -->
      <Border Grid.Row="0"
              Padding="12,10,12,10"
              Background="{DynamicResource BrushBg2}"
              BorderBrush="{DynamicResource BrushLine}"
              BorderThickness="0,0,0,1">
        <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
          <Image Source="{Binding SelectedPluginIcon}"
                 IsVisible="{Binding SelectedPluginHasIcon}"
                 Width="32" Height="32"
                 Stretch="UniformToFill"/>
          <TextBlock Text="{Binding SelectedPlugin.Manifest.Name}"
                     Classes="subheading"
                     VerticalAlignment="Center"/>
        </StackPanel>
      </Border>

      <!-- Inline edit row -->
      <Border Grid.Row="1"
              Padding="12,8"
              Background="{DynamicResource BrushBg0}"
              BorderBrush="{DynamicResource BrushLine}"
              BorderThickness="0,0,0,1">
        <Grid ColumnDefinitions="*,Auto,Auto,Auto">
          <TextBox Grid.Column="0"
                   Text="{Binding EditingPath}"
                   PlaceholderText="e.g. %APPDATA%\MyGame\Saves"
                   VerticalAlignment="Center"/>
          <Button Grid.Column="1"
                  Content="📂"
                  Command="{Binding BrowseForPathCommand}"
                  Classes="ghost icon-btn"
                  Width="30" Height="30"
                  Margin="4,0,0,0"
                  ToolTip.Tip="Browse for folder"/>
          <Button Grid.Column="2"
                  Content="✓"
                  Command="{Binding ConfirmPathCommand}"
                  Classes="ghost icon-btn"
                  Width="30" Height="30"
                  Foreground="{DynamicResource BrushGreen}"
                  Margin="2,0"/>
          <Button Grid.Column="3"
                  Content="✕"
                  Command="{Binding CancelEditPathCommand}"
                  Classes="ghost icon-btn"
                  Width="30" Height="30"
                  Foreground="{DynamicResource BrushRed}"/>
        </Grid>
      </Border>

      <!-- Resolved hint (live) -->
      <Border Grid.Row="2"
              Padding="16,5"
              Background="{DynamicResource BrushBg0}"
              BorderBrush="{DynamicResource BrushLine}"
              BorderThickness="0,0,0,1"
              IsVisible="{Binding EditingPathResolved, Converter={x:Static StringConverters.IsNotNullOrEmpty}}">
        <TextBlock Text="{Binding EditingPathResolved, StringFormat='→ {0}'}"
                   Classes="faint"/>
      </Border>

      <!-- Dimmed save list -->
      <ScrollViewer Grid.Row="3" Opacity="0.4" IsHitTestVisible="False">
        <ItemsControl ItemsSource="{Binding Saves}" Margin="8,0,8,8">
          <ItemsControl.ItemTemplate>
            <DataTemplate x:DataType="models:SaveFileInfo">
              <Border Margin="0,2"
                      Background="{DynamicResource BrushBg2}"
                      BorderBrush="{DynamicResource BrushLine}"
                      BorderThickness="1"
                      CornerRadius="0"
                      Padding="12,8">
                <TextBlock Text="{Binding FileName}" FontWeight="SemiBold"/>
              </Border>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
      </ScrollViewer>
    </Grid>

  </Grid>
</UserControl>
