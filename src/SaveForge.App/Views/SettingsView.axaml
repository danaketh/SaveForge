<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:SaveForge.App.ViewModels"
             x:Class="SaveForge.App.Views.SettingsView"
             x:DataType="vm:SettingsViewModel">
  <Grid RowDefinitions="Auto,*">

    <!-- Header -->
    <Border Grid.Row="0"
            Padding="16,14,16,12"
            Background="{DynamicResource BrushBg2}"
            BorderBrush="{DynamicResource BrushLine}"
            BorderThickness="0,0,0,1">
      <TextBlock Text="Settings" Classes="heading"/>
    </Border>

    <ScrollViewer Grid.Row="1">
      <StackPanel Margin="24,20" Spacing="16" MaxWidth="600">

        <StackPanel Spacing="4">
          <TextBlock Text="CATALOG URL" Classes="faint"/>
          <TextBox Text="{Binding CatalogUrl}"/>
        </StackPanel>

        <StackPanel Spacing="4">
          <TextBlock Text="PLUGIN DIRECTORY" Classes="faint"/>
          <TextBox Text="{Binding PluginDirectory}"/>
        </StackPanel>

        <StackPanel Spacing="4">
          <TextBlock Text="BACKUP DIRECTORY" Classes="faint"/>
          <TextBox Text="{Binding BackupDirectory}"/>
        </StackPanel>

        <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,4,0,0">
          <Button Content="Save Settings" Command="{Binding SaveSettingsCommand}" Classes="primary"/>
          <Button Content="Check for Updates" Command="{Binding CheckUpdatesCommand}" Classes="ghost"/>
        </StackPanel>

      </StackPanel>
    </ScrollViewer>

  </Grid>
</UserControl>
