<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="SaveForge.App.Controls.TitleBarControl"
             Height="30"
             Background="{DynamicResource BrushBg0}">

  <Border BorderBrush="{DynamicResource BrushLine}"
          BorderThickness="0,0,0,1">
    <Grid ColumnDefinitions="Auto,Auto,*,Auto">

      <!-- Amber pixel logo -->
      <Border Grid.Column="0"
              Width="16" Height="16"
              Margin="12,0,6,0"
              Background="{DynamicResource BrushAmber}"
              VerticalAlignment="Center">
        <TextBlock Text="S"
                   FontFamily="{DynamicResource PixelFont}"
                   FontSize="11"
                   Foreground="#1A1000"
                   HorizontalAlignment="Center"
                   VerticalAlignment="Center"/>
      </Border>

      <!-- App name -->
      <TextBlock Grid.Column="1"
                 Text="SaveForge"
                 Classes="dim"
                 FontSize="11"
                 VerticalAlignment="Center"
                 Margin="0,0,16,0"/>

      <!-- Drag region -->
      <Panel Grid.Column="2" x:Name="DragRegion" Background="Transparent"/>

      <!-- Window controls -->
      <StackPanel Grid.Column="3" Orientation="Horizontal">
        <Button x:Name="MinimizeButton" Content="─"
                Width="46" Height="30"
                Background="Transparent" BorderThickness="0"
                Foreground="{DynamicResource BrushTextDim}"
                Classes="ghost"/>
        <Button x:Name="MaximizeButton" Content="□"
                Width="46" Height="30"
                Background="Transparent" BorderThickness="0"
                Foreground="{DynamicResource BrushTextDim}"
                Classes="ghost"/>
        <Button x:Name="CloseButton" Content="✕"
                Width="46" Height="30"
                Background="Transparent" BorderThickness="0"
                Foreground="{DynamicResource BrushTextDim}"
                Classes="ghost close-btn"/>
      </StackPanel>

    </Grid>
  </Border>

</UserControl>
